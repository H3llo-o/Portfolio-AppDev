@model Portfolio_Appdev.Models.Profile

@{
    ViewData["Title"] = "Home Page";
}

<style>
    body {
        background-color: #001C47;
        color: #D3AF37;
        font-family: Arial, sans-serif;
    }

    .sep-line {
        width: 95%;
        border: none;
        border-top: 6px solid #D3AF37;
        margin: 5px auto;
        opacity: 1;
    }

    .contact-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 90%;
        margin: 0px auto;
    }

    .contact-info p {
        margin-bottom: 5px;
    }

</style>

<div class="text-center">
    <h1 class="display-4">Welcome!</h1>
    <h1>I am @Model.Name</h1>
    <p>@Model.About</p>

    <div class="contact-info">
        <p>@Model.Number</p>
        <p>@Model.Email</p>
        <p>@Model.Address</p>
    </div>

    <hr class="sep-line">
</div>

<div class="text-justify">
    <h1>Educational Background</h1>
    <h2>Polytechnic University of the Philippines - Mabini Campus</h2>
    <ul>
        @foreach (var skill in Model.CollegeBg)
        {
            <li>@skill</li>
        }
    </ul>

    <h2>Pasig City Science High School</h2>
    <ul>
        @foreach (var skill in Model.HSBg)
        {
            <li>@skill</li>
        }
    </ul>
</div>

<hr class="sep-line">

<div class="skill-container skill-left">
<div class = "skill-container">
    <div class = "skill-button">
        <h2>Data Science</h2>
        <ul>
            @foreach (var skill in Model.DataScienceSkills)
            {
                <li>@skill</li>
            }
        </ul>
    </div>

    <div class = "skill-panel">
         @foreach (var skill in Model.DataScienceSkills)
        {
            if (skill == "Python")
            {
                <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg"
                     alt="Python" />
            }
            else if (skill == "R")
            {
                <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/r/r-original.svg"
                     alt="R" />
            }
            else if (skill == "SQL")
            {
                <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mysql/mysql-original.svg"
                     alt="SQL" />
            }
        }
    </div>
</div>
</div>

<div class="skill-container skill-right">
<div class = "skill-container">
    <div class = "skill-button">
        <h2>Programming</h2>

        <ul>
            @foreach (var skill in Model.ProgrammingSkills)
            {
                <li>@skill</li>
            }
        </ul>
    </div>

     <div class = "skill-panel">
         @foreach (var skill in Model.ProgrammingSkills)
        {
            if (skill == "C#")
            {
                <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/csharp/csharp-original.svg"
                     alt="C#" />
            }
            else if (skill == "Java")
            {
                <img src="https://iconape.com/wp-content/files/zy/371206/svg/371206.svg"
                     alt="Java" />
            }
        }
    </div>
</div>
</div>

<div class="skill-container skill-left">
<div class = "skill-container">
        <div class = "skill-button">
            <h2>Web Development</h2>

            <ul>
                @foreach (var skill in Model.WebDevelopmentSkills)
                {
                    <li>@skill</li>
                }
            </ul>
        </div>

        <div class = "skill-panel">
         @foreach (var skill in Model.WebDevelopmentSkills)
        {
            if (skill == "HTML")
            {
                <img src="https://banner2.cleanpng.com/20180529/loy/kisspng-html-computer-icons-icon-design-5b0de82f39f353.2568037815276380632374.jpg"
                     alt="HTML" />
            }
            else if (skill == "CSS")
            {
                <img src="https://banner2.cleanpng.com/20180503/thq/avdoer0cb.webp"
                     alt="CSS" />
            }
            else if (skill == "JavaScript")
            {
                <img src="https://iconape.com/wp-content/files/ez/353342/png/javascript-logo.png"
                     alt="JavaScript" />
            }
        }
    </div>
</div>
</div>

<div class="skill-container skill-right">
<div class = "skill-container">
     <div class = "skill-button">
        <h2>Arts & Design</h2>

        <ul>
            @foreach (var skill in Model.ArtsDesignSkills)
            {
                <li>@skill</li>
            }
        </ul>
    </div>

    <div class = "skill-panel">
         @foreach (var skill in Model.ArtsDesignSkills)
            {
                if (skill == "Adobe Photoshop")
                {
                    <img src="https://iconape.com/wp-content/files/ix/373285/png/373285.png"
                        alt="Adobe Photoshop" />
                }
            }
    </div>  
</div>
</div>

<div class="skill-container skill-left">
<div class = "skill-container">
    <div class = "skill-button">
        <h2>Collaboration</h2>

        <ul>
            @foreach (var skill in Model.CollaborationSkills)
            {
                <li>@skill</li>
            }
        </ul>
    </div>

    <div class = "skill-panel">
         @foreach (var skill in Model.CollaborationSkills)
        {
            if (skill == "GitHub")
            {
                <img src="https://iconape.com/wp-content/files/ni/388833/svg/388833.svg"
                     alt="GitHub" />
            }
            else if (skill == "Online Document Collaboration Tools")
            {
                <img src="https://iconape.com/wp-content/files/ch/387943/svg/387943.svg"
                     alt="Online Document Collaboration Tools" />
            }
            else if (skill == "Online Communication Platforms")
            {
                <img src="https://iconape.com/wp-content/files/ju/346843/png/microsoft-teams-logo.png"
                     alt="Online Communication Platforms" />
            }
        }
    </div>   
</div>
</div>